<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Shop Titans — BiS tracker</title>
<style>
:root{color-scheme:light dark;--bg:#f4f4f4;--panel:#fff;--text:#151515;--muted:#666;--border:#cfcfcf;--chip:#eee;--active:#1f6feb;--activeText:#fff;--shadow:0 1px 2px rgba(0,0,0,.06)}
@media(prefers-color-scheme:dark){:root{--bg:#111315;--panel:#1b1e22;--text:#f3f4f6;--muted:#a7adb5;--border:#343941;--chip:#252a30;--active:#4c8dff;--activeText:#08111f;--shadow:none}}
*{box-sizing:border-box}body{font-family:system-ui,-apple-system,Segoe UI,sans-serif;margin:0;background:var(--bg);color:var(--text)}.page{max-width:1500px;margin:auto;padding:18px}.top{position:sticky;top:0;background:color-mix(in srgb,var(--bg) 94%,transparent);backdrop-filter:blur(8px);padding:8px 0 12px;z-index:5;border-bottom:1px solid var(--border)}h1{font-size:1.5rem;margin:.25rem 0 .3rem}.sub{color:var(--muted);margin:0 0 12px;font-size:.92rem}.controls{display:grid;grid-template-columns:minmax(220px,1fr) auto auto;gap:10px;align-items:end}.control label{display:block;font-size:.78rem;color:var(--muted);margin-bottom:4px}.search{width:100%;font-size:16px;padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:var(--panel);color:var(--text)}select,button{font:inherit;border:1px solid var(--border);border-radius:10px;padding:9px 11px;background:var(--panel);color:var(--text)}button{cursor:pointer}.count{font-weight:650;white-space:nowrap;padding:9px 0}.filters{margin-top:10px;display:grid;gap:8px}.filter-section{border:1px solid var(--border);border-radius:12px;background:var(--panel);padding:9px 11px}.filter-section summary{cursor:pointer;font-weight:650}.chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:9px}.filter-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);background:var(--chip);padding:6px 9px;border-radius:999px;cursor:pointer;font-size:.86rem}.filter-chip input{accent-color:var(--active)}.filter-chip:has(input:checked){background:var(--active);border-color:var(--active);color:var(--activeText)}.filter-chip b{font-size:.73rem;opacity:.7}.active-summary{font-size:.82rem;color:var(--muted);margin-top:7px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:14px;margin-top:16px}.card{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:12px;box-shadow:var(--shadow)}.image-wrap{aspect-ratio:1;border-radius:10px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:color-mix(in srgb,var(--panel) 80%,var(--bg))}.card img{width:100%;height:100%;object-fit:contain}.name{font-weight:700;margin-top:8px}.tier{color:var(--muted);margin-top:2px;font-size:.9rem}.recipe{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.recipe-group{border-top:1px solid var(--border);padding-top:7px}.recipe h3,.hero-use h3{font-size:.78rem;margin:0 0 4px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}.recipe ul{list-style:none;margin:0;padding:0}.recipe li{display:flex;justify-content:space-between;gap:7px;font-size:.82rem;padding:2px 0}.hero-use{margin-top:9px;border-top:1px solid var(--border);padding-top:7px}.hero-tags{display:flex;flex-wrap:wrap;gap:5px}.hero-tag{display:inline-block;border:1px solid var(--border);background:var(--chip);border-radius:999px;padding:4px 7px;font-size:.75rem}.hidden{display:none!important}.empty{grid-column:1/-1;text-align:center;padding:40px 12px;color:var(--muted)}.footer{margin-top:18px;color:var(--muted);font-size:.8rem}.footer a{color:inherit}@media(max-width:760px){.controls{grid-template-columns:1fr 1fr}.control.search-control{grid-column:1/-1}.top{position:static}.recipe{grid-template-columns:1fr}}
</style></head><body><div class="page">
<header class="top"><h1>BiS de Shop Titans</h1>
<details class="filter-section"><summary>Filtros</summary>
<div class="controls"><div class="control search-control"><label for="q">Buscar por item, héroe o material</label><input class="search" id="q" placeholder="Ej. Titan, Knight, Iron…" type="search"></div><div class="control"><label for="mode">Coincidencia entre materiales</label><select id="mode"><option value="all">Todos los seleccionados</option><option value="any">Cualquiera</option></select></div><div><button id="reset">Limpiar filtros</button></div><div class="count" id="count">{{items|length}} de {{items|length}} items</div></div>
<div class="filters">
<details class="filter-section" open><summary>Clases de héroe con este item en su BiS</summary><div class="chips">{% for hero,label in hero_labels|dictsort %}{% if hero_counts[hero] %}<label class="filter-chip"><input type="checkbox" data-group="hero" value="{{hero}}">{{label}} <b>{{hero_counts[hero]}}</b></label>{% endif %}{% endfor %}</div></details>
<details class="filter-section"><summary>Recursos básicos / de producción</summary><div class="chips">{% for mat,count in basic_counts|dictsort %}<label class="filter-chip"><input type="checkbox" data-group="basic" value="{{mat}}">{{mat}}{{' (cloth)' if mat=='Fabric' else ''}} <b>{{count}}</b></label>{% endfor %}</div></details>
<details class="filter-section"><summary>Componentes y materiales especiales</summary><div class="chips">{% for mat,count in special_counts|dictsort %}<label class="filter-chip"><input type="checkbox" data-group="special" value="{{mat}}">{{mat}} <b>{{count}}</b></label>{% endfor %}</div></details>
</div></details>
<div class="active-summary" id="activeSummary">Sin filtros activos</div></header>
<main class="grid" id="grid">{% for x in items %}<article class="card" data-name="{{x.name|lower}}" data-materials='{{(x.resources.keys()|list + x.components.keys()|list)|tojson}}' data-heroes='{{x.heroes|tojson}}'>
<div class="image-wrap"><img alt="{{x.name}}" loading="lazy" src="{{x.image_data}}"></div><div class="name">{{loop.index}}. {{x.name}}</div><div class="tier">T{{x.tier}}</div>
<div class="hero-use"><h3>Usado en BiS por</h3><div class="hero-tags">{% for h in x.heroes %}<span class="hero-tag">{{hero_labels.get(h,h)}}</span>{% endfor %}</div></div>
<div class="recipe"><div class="recipe-group"><h3>Recursos</h3><ul>{% for m,q in x.resources.items() %}<li><span>{{m}}{{' (cloth)' if m=='Fabric' else ''}}</span><strong>{{q}}</strong></li>{% endfor %}</ul></div><div class="recipe-group"><h3>Componentes</h3><ul>{% for m,q in x.components.items() %}<li><span>{{m}}</span><strong>{{q}}</strong></li>{% endfor %}</ul></div></div></article>{% endfor %}</main>
<footer class="footer">Generado: {{metadata.generated_at_utc or metadata.snapshot_date}} · Fuente BiS: ST Central · Recetas: Shop Titans Data Spreadsheet (Kabam). Este proyecto no está afiliado con Kabam ni ST Central.</footer></div>
<script>const cards=[...document.querySelectorAll('.card')],q=document.getElementById('q'),materialChecks=[...document.querySelectorAll('input[data-group="basic"],input[data-group="special"]')],heroChecks=[...document.querySelectorAll('input[data-group="hero"]')],mode=document.getElementById('mode'),count=document.getElementById('count'),summary=document.getElementById('activeSummary'),reset=document.getElementById('reset'),grid=document.getElementById('grid');let empty=null;function sel(a){return a.filter(c=>c.checked).map(c=>c.value)}function norm(s){return s.toLocaleLowerCase('en').normalize('NFD').replace(/[\u0300-\u036f]/g,'')}function apply(){const text=norm(q.value.trim()),m=sel(materialChecks),h=sel(heroChecks),all=mode.value==='all';let shown=0;cards.forEach(c=>{const cm=JSON.parse(c.dataset.materials),ch=JSON.parse(c.dataset.heroes),okText=!text||norm(c.dataset.name).includes(text)||cm.some(x=>norm(x).includes(text))||ch.some(x=>norm(x).includes(text)),okM=!m.length||(all?m.every(x=>cm.includes(x)):m.some(x=>cm.includes(x))),okH=!h.length||h.some(x=>ch.includes(x)),v=okText&&okM&&okH;c.classList.toggle('hidden',!v);if(v)shown++});count.textContent=`${shown} de ${cards.length} items`;const p=[];if(h.length)p.push(`Héroes: ${h.join(', ')}`);if(m.length)p.push(`${all?'Todos':'Cualquiera'}: ${m.join(', ')}`);if(q.value.trim())p.push(`Texto: “${q.value.trim()}”`);summary.textContent=p.length?p.join(' · '):'Sin filtros activos';if(!shown){if(!empty){empty=document.createElement('div');empty.className='empty';empty.textContent='No hay objetos que cumplan esos filtros.';grid.appendChild(empty)}empty.classList.remove('hidden')}else if(empty)empty.classList.add('hidden')}q.addEventListener('input',apply);[...materialChecks,...heroChecks].forEach(c=>c.addEventListener('change',apply));mode.addEventListener('change',apply);reset.addEventListener('click',()=>{q.value='';[...materialChecks,...heroChecks].forEach(c=>c.checked=false);mode.value='all';apply()});apply();</script></body></html>
